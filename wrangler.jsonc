{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "five-plates",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  // Files in /public are served from the edge without running the worker; only /api/* runs code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "five-plates",
      "database_id": "66c70954-9db8-4db3-81c0-68102058ff29",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Refresh King Soopers prices every morning at 5am Mountain (11:00 UTC).
  "triggers": { "crons": ["0 11 * * *"] }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   FAMILY_PASSCODE, SESSION_SECRET, ALLOWED_EMAILS (comma-separated),
  //   KROGER_CLIENT_ID, KROGER_CLIENT_SECRET, ADMIN_TOKEN (optional, for maintenance scripts)
}
