{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "five-plates",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  // Files in /public are served from the edge without running the worker; only /api/* runs code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "five-plates",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   FAMILY_PASSCODE, SESSION_SECRET, ALLOWED_EMAILS (comma-separated)
}
